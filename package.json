{
  "name": "nishiyama-park-app",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:data": "node scripts/build-data.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "optimize:images": "node scripts/optimize-images.mjs",
    "typecheck": "tsc --noEmit",
    "check:claim": "esbuild scripts/check-claim.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=node_modules/.cache/check-claim.mjs --log-level=error && node node_modules/.cache/check-claim.mjs",
    "check:url": "esbuild scripts/check-url.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=node_modules/.cache/check-url.mjs --log-level=error && node node_modules/.cache/check-url.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
