---
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  lead?: string;
}

const { id, eyebrow, title, lead } = Astro.props;
---

<section id={id} class="scroll-mt-20">
  <p class="text-xs font-medium tracking-[0.2em] text-emerald-700 uppercase">{eyebrow}</p>
  <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl">{title}</h2>
  {lead && <p class="mt-3 max-w-2xl leading-relaxed text-stone-600">{lead}</p>}
  <div class="mt-7">
    <slot />
  </div>
</section>
