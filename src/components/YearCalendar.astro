---
import { byMonth } from '../lib/insights';

const max = Math.max(...byMonth.map((month) => month.average));

const BADGE_CLASS: Record<string, string> = {
  sakura: 'bg-pink-100 text-pink-900',
  tsutsuji: 'bg-rose-100 text-rose-900',
  shinryoku: 'bg-emerald-100 text-emerald-900',
  kouyou: 'bg-amber-100 text-amber-900',
  winter: 'bg-sky-100 text-sky-900',
};

const months = byMonth.map((month) => ({
  ...month,
  ratio: month.average / max,
  badge: BADGE_CLASS[month.highlight.id] ?? 'bg-stone-100 text-stone-700',
  isPeak: month.average >= max * 0.5,
}));
---

<ol class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
  {
    months.map((month) => (
      <li class="rounded-2xl bg-white p-4 ring-1 ring-stone-200">
        <div class="flex items-baseline justify-between">
          <span class="text-xl font-bold text-stone-900">{month.label}</span>
          <span class="text-xs tabular-nums text-stone-400">{month.averageTempMax}℃</span>
        </div>
        <span class={`mt-2 inline-block rounded-full px-2.5 py-1 text-xs font-medium ${month.badge}`}>
          {month.highlight.name}
        </span>
        <svg
          viewBox="0 0 100 8"
          preserveAspectRatio="none"
          class="mt-3 h-2 w-full"
          role="img"
          aria-label={`1日平均${month.average}人`}
        >
          <rect x="0" y="0" width="100" height="8" fill="#f5f5f4" />
          <rect x="0" y="0" width={month.ratio * 100} height="8" fill={month.isPeak ? '#15803d' : '#a8a29e'} />
        </svg>
        <p class="mt-2 text-sm tabular-nums text-stone-600">
          1日平均 <span class="font-semibold text-stone-900">{month.average.toLocaleString()}</span> 人
        </p>
      </li>
    ))
  }
</ol>
