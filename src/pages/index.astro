---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import { ParkApp } from '../components/ParkApp';
import { ParkStatus } from '../components/ParkStatus';
import { ICON } from '../constants/icons';
import { NEARBY_SPOTS } from '../lib/geo';
import { BLOOM_WINDOWS } from '../lib/seasonality';
import type { Highlight } from '../types/ui';
import { formatMonthDay } from '../utils/date';

const loadImages = (records: Record<string, { default: ImageMetadata }>) =>
  Object.entries(records)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, module]) => module.default);

/**
 * カードのキャプション。写真ごとの説明データは存在しないため、
 * 「その写真の説明」ではなく園の事実を1枚ずつ違う内容で載せる。
 * 株数と植栽場所は tsutsuji.json、人出と見頃は日別来訪者数365日から。
 */
const CAPTIONS: Record<string, readonly string[]> = {
  tsutsuji: [
    'ヒラドツツジは31,400株。園内11種50,025株のうち6割強を占め、公園全体に植わっています。',
    'ドウダンツツジ5,600株は嚮陽庭園と嚮陽会館駐車場に。春に白い花をつけた同じ木が、秋には紅葉します。',
    'サツキ4,000株は西山橋下の緑化ブロックに植えられています。',
    'オオムラサキ3,000株はパンダらんど駐車場ほかに。ヒラドツツジより濃い紫が混じります。',
    'キリシマ2,390株は結びの広場と、ピクニック広場南側の階段沿いに。',
    'レンゲツツジ1,690株とクルメツツジ1,420株はピクニック広場にまとまっています。',
    'ミツバツツジ150株、リュウキュウツツジ250株、ミナヤマツツジ100株はパンダらんどに。11種あわせて50,025株です。',
  ],
  kouyou: [
    '見頃は11/15〜11/28。日別来訪者数365日から、曜日と天気の影響を取り除いて機械的に導いたウィンドウです。',
    '人出のピークは11/16の1,310人。ツツジの5/5は4,550人なので、3分の1以下で見られます。',
    '秋の人出の中央値は300人。春の450人より静かです。',
    '嚮陽庭園のドウダンツツジ5,600株は、春に白い花をつけた同じ木が秋に色づきます。',
    '15〜25℃で晴れか曇りの日は、秋は91日中30日。春の39日に次ぐ多さです。',
    '併設の西山動物園は入園無料。レッサーパンダに会えます。',
    '西山公園は「日本の歴史公園100選」に選ばれています。',
  ],
};

const SOURCES = [
  {
    id: 'tsutsuji',
    title: 'ツツジ',
    lead: 'ヒラドツツジを中心に11種50,025株が斜面を埋めます。',
    photos: loadImages(
      import.meta.glob<{ default: ImageMetadata }>('../assets/images/tsutsuji/*.webp', {
        eager: true,
      })
    ),
  },
  {
    id: 'kouyou',
    title: '紅葉',
    lead: '嚮陽庭園のモミジとドウダンツツジが色づきます。春に次ぐ年2回目の山です。',
    photos: loadImages(
      import.meta.glob<{ default: ImageMetadata }>('../assets/images/kouyou/*.webp', {
        eager: true,
      })
    ),
  },
];

/** Reactへは最適化後のURLを渡す。astro:assets はビルド時にしか使えない */
const highlights: Highlight[] = await Promise.all(
  SOURCES.map(async (source) => {
    const window = BLOOM_WINDOWS.find((item) => item.id === source.id);
    const captions = CAPTIONS[source.id] ?? [];
    const photos = await Promise.all(
      source.photos.map(async (photo, index) => {
        const [card, full] = await Promise.all([
          // カードは正方形に切る。縦長と横長が混在しても並びが揃う
          getImage({ src: photo, width: 800, height: 800, format: 'webp', quality: 68 }),
          // 拡大用は幅だけ指定して比率を保つ
          getImage({ src: photo, width: 1200, format: 'webp', quality: 72 }),
        ]);
        return {
          card: card.src,
          caption: captions[index] ?? '',
          full: full.src,
          fullWidth: Number(full.attributes.width ?? 1200),
          fullHeight: Number(full.attributes.height ?? 900),
        };
      })
    );
    return {
      id: source.id,
      title: source.title,
      lead: source.lead,
      window: window
        ? `${formatMonthDay(window.fromKey)}〜${formatMonthDay(window.toKey)}`
        : null,
      photos,
    };
  })
);
---

<Layout
  title="ICOSSA | 福井に来たら、西山公園へ"
  description={`福井県鯖江市の西山公園は、福井鉄道西山公園駅から徒歩1分。市が公開する座標で測った駅・バス停・周辺${NEARBY_SPOTS.length}件の分布を地図で見て、寄り道ルートを組めます。オープンデータ活用アプリコンテスト2026 応募作品。`}
>
  <div class="flex flex-col lg:h-dvh">
    <header
      class="flex shrink-0 flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-stone-200 bg-white px-4 py-2 sm:px-6 lg:h-14 lg:flex-nowrap lg:py-0"
    >
      <div class="flex min-w-0 items-baseline gap-2.5">
        <p class="text-sm font-bold tracking-tight text-stone-900">ICOSSA</p>
        <p class="truncate text-xs text-stone-500">
          西山公園<span class="hidden xl:inline">（福井県鯖江市） — 鯖江市オープンデータで見る</span>
        </p>
      </div>

      <div class="order-3 -ml-2.5 w-full min-w-0 lg:order-none lg:ml-0 lg:w-auto">
        <ParkStatus client:load />
      </div>

      <a
        href="https://data.city.sabae.lg.jp/"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden shrink-0 text-xs text-stone-500 underline decoration-stone-300 underline-offset-4 transition duration-150 hover:text-stone-900 lg:block"
      >
        出典: 鯖江市オープンデータ
      </a>

      <div class="relative shrink-0 lg:hidden" data-menu>
        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-label="メニューを開く"
          class="flex h-9 w-9 items-center justify-center rounded-lg text-stone-600 transition duration-150 hover:bg-brand-50 hover:text-stone-900"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
            class="h-5 w-5"
          >
            <path d={ICON.menu} />
          </svg>
        </button>

        <div
          data-menu-panel
          hidden
          class="absolute top-full right-0 z-1000 mt-2 w-[min(17rem,calc(100vw-2rem))] overflow-hidden rounded-2xl bg-white shadow-lg ring-1 ring-stone-200"
        >
          <button
            type="button"
            data-menu-panel-open="sources"
            class="flex w-full items-center gap-2.5 px-4 py-3 text-left transition duration-150 hover:bg-brand-50"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="h-5 w-5 shrink-0 text-stone-400"
            >
              <path d={ICON.data} />
            </svg>
            <span>
              <span class="block text-sm font-bold text-stone-900">データ</span>
              <span class="block text-xs text-stone-500">出典と注意点</span>
            </span>
          </button>

          <div class="border-t border-stone-200 px-4 py-3">
            <p class="text-xs text-stone-500">出典</p>
            <a
              href="https://data.city.sabae.lg.jp/"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-1.5 block text-sm text-stone-900 underline decoration-stone-300 underline-offset-4"
            >
              鯖江市オープンデータ
            </a>
            <a
              href="https://maps.gsi.go.jp/development/ichiran.html"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 block text-sm text-stone-900 underline decoration-stone-300 underline-offset-4"
            >
              地理院タイル（国土地理院）
            </a>
          </div>
        </div>
      </div>

    </header>

    <ParkApp highlights={highlights} client:only="react" />
  </div>
</Layout>

<script>
  import { PANEL_EVENT } from '../constants/events';

  // ヘッダーはAstroが描き、パネルの状態はReact側が持つ。両者をイベントで繋ぐ
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const toggle = menu?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = menu?.querySelector<HTMLElement>('[data-menu-panel]');

  if (menu && toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
    };

    toggle.addEventListener('click', () => setOpen(panel.hidden));

    for (const button of panel.querySelectorAll<HTMLButtonElement>('[data-menu-panel-open]')) {
      button.addEventListener('click', () => {
        const id = button.dataset.menuPanelOpen;
        if (id) window.dispatchEvent(new CustomEvent(PANEL_EVENT, { detail: id }));
        setOpen(false);
      });
    }

    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && menu.contains(event.target)) return;
      setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
