---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import { ParkApp, type Highlight } from '../components/ParkApp';
import { ParkStatus } from '../components/ParkStatus';
import { formatMonthDay } from '../lib/days';
import { NEARBY_SPOTS } from '../lib/geo';
import { BLOOM_WINDOWS } from '../lib/seasonality';

const loadImages = (records: Record<string, { default: ImageMetadata }>) =>
  Object.entries(records)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, module]) => module.default);

const SOURCES = [
  {
    id: 'tsutsuji',
    title: 'ツツジ',
    lead: 'ヒラドツツジを中心に11種50,025株が斜面を埋めます。',
    photos: loadImages(
      import.meta.glob<{ default: ImageMetadata }>('../assets/images/tsutsuji/*.webp', {
        eager: true,
      })
    ),
  },
  {
    id: 'kouyou',
    title: '紅葉',
    lead: '嚮陽庭園のモミジとドウダンツツジが色づきます。春に次ぐ年2回目の山です。',
    photos: loadImages(
      import.meta.glob<{ default: ImageMetadata }>('../assets/images/kouyou/*.webp', {
        eager: true,
      })
    ),
  },
];

/** Reactへは最適化後のURLを渡す。astro:assets はビルド時にしか使えない */
const highlights: Highlight[] = await Promise.all(
  SOURCES.map(async (source) => {
    const window = BLOOM_WINDOWS.find((item) => item.id === source.id);
    const photos = await Promise.all(
      source.photos.map(async (photo) => {
        const [thumb, medium, full] = await Promise.all([
          getImage({ src: photo, width: 320, height: 240, format: 'webp', quality: 60 }),
          getImage({ src: photo, width: 800, height: 600, format: 'webp', quality: 68 }),
          // 縦長と横長が混在するので、拡大用は幅だけ指定して比率を保つ
          getImage({ src: photo, width: 1200, format: 'webp', quality: 72 }),
        ]);
        return {
          src: thumb.src,
          width: 320,
          height: 240,
          medium: medium.src,
          full: full.src,
          fullWidth: Number(full.attributes.width ?? 1200),
          fullHeight: Number(full.attributes.height ?? 900),
        };
      })
    );
    return {
      id: source.id,
      title: source.title,
      lead: source.lead,
      window: window
        ? `${formatMonthDay(window.fromKey)}〜${formatMonthDay(window.toKey)}`
        : null,
      photos,
    };
  })
);
---

<Layout
  title="西山公園は駅から歩ける | 鯖江市オープンデータで見る西山公園"
  description={`福井県鯖江市の西山公園は、福井鉄道西山公園駅から徒歩1分。市が公開する座標で測った駅・バス停・周辺${NEARBY_SPOTS.length}件の分布を地図で見て、寄り道ルートを組めます。オープンデータ活用アプリコンテスト2026 応募作品。`}
>
  <div class="flex flex-col lg:h-dvh">
    <header
      class="flex shrink-0 flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-stone-200 bg-white px-4 py-2 sm:px-6 lg:h-14 lg:flex-nowrap lg:py-0"
    >
      <div class="flex min-w-0 items-baseline gap-2.5">
        <p class="text-sm font-bold tracking-tight text-stone-900">西山公園</p>
        <p class="hidden truncate text-xs text-stone-500 xl:block">
          福井県鯖江市 — 鯖江市オープンデータで見る
        </p>
      </div>

      <div class="order-3 -ml-2.5 w-full min-w-0 lg:order-none lg:ml-0 lg:w-auto">
        <ParkStatus client:load />
      </div>

      <a
        href="https://data.city.sabae.lg.jp/"
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 text-xs text-stone-500 underline decoration-stone-300 underline-offset-4 transition duration-150 hover:text-stone-900"
      >
        出典: 鯖江市オープンデータ
      </a>
    </header>

    <ParkApp highlights={highlights} client:only="react" />
  </div>
</Layout>
